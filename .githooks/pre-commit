#!/bin/sh
# HARD ENFORCE on every commit: (1) staged prose holds the floor (gate + predictions),
# (2) chain-of-custody is intact and the intention constructive (forensics), (3) the whole theorem
# suite + discovery ledger re-verifies. Any fails → the commit is blocked at the boundary.
node scripts/precommit.ts || exit 1
node scripts/forensics.ts || { echo "✗ pre-commit: forensics — chain-of-custody tamper or destructive intention at the boundary — run: npm run forensics"; exit 1; }
node scripts/lean-claims.ts >/dev/null 2>&1 || { echo "✗ pre-commit: theorem suite / ledger re-verification FAILED — run: npm run lean-claims"; exit 1; }
# PARALLEL, FAIL FAST: anti-fake, constants, the MCP gate and hardcode run at once; the court runs only after they pass.
node scripts/gate-parallel.ts --commit || { echo "✗ pre-commit: refused — see the stream named above"; exit 1; }
echo "✓ pre-commit: gate + forensics (chain-of-custody + intention) + all theorems + ledger re-verify"
