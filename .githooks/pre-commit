#!/bin/sh
# HARD ENFORCE on every commit: (1) staged prose holds the floor (gate + predictions),
# (2) chain-of-custody is intact and the intention constructive (forensics), (3) the whole theorem
# suite + discovery ledger re-verifies. Any fails → the commit is blocked at the boundary.
node scripts/precommit.ts || exit 1
# A page description past the search-result line (DESC_CAP) halts the ship at seo.ts, after an 18-min build.
# It is decidable from the frontmatter with no build, so it is caught here, when the page is written.
node scripts/seo-source.ts || { echo "✗ pre-commit: a page description exceeds the search-result limit — shorten the frontmatter \`description:\` (run: npm run seo:source)"; exit 1; }
node scripts/forensics.ts || { echo "✗ pre-commit: forensics — chain-of-custody tamper or destructive intention at the boundary — run: npm run forensics"; exit 1; }
node scripts/lean-claims.ts >/dev/null 2>&1 || { echo "✗ pre-commit: theorem suite / ledger re-verification FAILED — run: npm run lean-claims"; exit 1; }
# PARALLEL, FAIL FAST: anti-fake, constants, the MCP gate and hardcode run at once; the court runs only after they pass.
node scripts/gate-parallel.ts --commit || { echo "✗ pre-commit: refused — see the stream named above"; exit 1; }
# (4) FRESHNESS NET — every ledger-derived file is a fixed point of its generator. The gates above check the
# front pages and settled.lean; this catches the quiet ones they do not — the per-theorem depositions,
# llms.txt, covered.json, trial-all.json — so none can be committed stale by any path. seal-lean --seal
# regenerates them, so this rarely fires; when it does, the tree was changed without reconciling. Runs last,
# so it only pays for its generators on a commit the other gates already cleared.
node scripts/reconcile.ts --check || { echo "✗ pre-commit: ledger-derived files are stale — run: npm run reconcile, then recommit"; exit 1; }
echo "✓ pre-commit: gate + forensics + theorems + reconcile + deploy-e2e (build+e2e+deploy gates)"
