{
  "name": "@uuidna/uuidna",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Content-addressed identity, honest by construction — mint + mind, holographic merkle proofs, a reversible imprint codec, a reeducating harness, a measured billing model, pure-TypeScript ChaCha20-Poly1305 encryption (no native crypto) under a 7d-fold envelope, and an MCP server to fuse it into any harness. Integrity, not truth. 0/7.",
  "type": "module",
  "license": "CC-BY-NC-4.0",
  "author": "Tsvetan Rouschev <ceccec@psg.bg>",
  "homepage": "https://github.com/uuidna/uuidna",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uuidna/uuidna.git"
  },
  "bugs": {
    "url": "https://github.com/uuidna/uuidna/issues"
  },
  "keywords": [
    "uuid",
    "content-address",
    "merkle",
    "merkle-proof",
    "integrity",
    "fnv",
    "hash",
    "identity",
    "mcp",
    "model-context-protocol"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/uuidna.min.js",
  "jsdelivr": "./dist/uuidna.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./address": {
      "types": "./dist/address.d.ts",
      "import": "./dist/address.js"
    },
    "./gate": {
      "types": "./dist/gate.d.ts",
      "import": "./dist/gate.js"
    },
    "./merkle": {
      "types": "./dist/merkle.d.ts",
      "import": "./dist/merkle.js"
    },
    "./crypt": {
      "types": "./dist/crypt.d.ts",
      "import": "./dist/crypt.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "uuidna": "./cli.mjs",
    "uuidna-mcp": "./mcp.mjs"
  },
  "files": [
    "dist",
    "cli.mjs",
    "mcp.mjs",
    "API.md",
    "README.md",
    "LICENSE",
    "reserved.uuidna"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint:agnostic": "node lint-agnostic.mjs",
    "gate:prose": "node gate-prose.mjs",
    "bundle": "node bundle.mjs",
    "docs": "node docs.mjs",
    "reserve": "node reserve.mjs",
    "pack:check": "node pack-check.mjs",
    "build": "npm run lint:agnostic && tsc -p tsconfig.json && npm run gate:prose && npm run bundle && npm run docs",
    "test": "npm run build && node --test test/*.test.mjs",
    "conformance": "node test/conformance.mjs",
    "conformance:deno": "deno run --allow-read test/conformance.mjs",
    "conformance:bun": "bun test/conformance.mjs",
    "conformance:browser": "node test/browser-conformance.mjs",
    "mcp": "node mcp.mjs",
    "prepublishOnly": "npm run build && npm run reserve && npm run pack:check"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
