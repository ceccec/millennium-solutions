   }
  },
  {
   "@type": "ListItem",
   "position": 24,
   "item": {
    "@type": "ScholarlyArticle",
    "name": "the_unstamped_bits_read_back_from_every_stamped_byte",
    "description": "∀ b : Nat, b < 256 → and8 (or8 (and8 b 15) 128) 15 = b % 16 ∧ and8 (or8 (and8 b 63) 128) 63 = b % 64",
    "identifier": "lean_address_the_unstamped_bits_read_back_from_every_stamped_byte",
    "url": "https://ceccec.psg.bg/millennium-solutions/theorem/lean_address_the_unstamped_bits_read_back_from_every_stamped_byte",
    "receipt": "69a4f3a2-4653-8fa2-9a1c-def31a7802b9",
    "about": {
     "@type": "DefinedTerm",
