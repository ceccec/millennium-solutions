   }
  },
  {
   "@type": "ListItem",
   "position": 25,
   "item": {
    "@type": "ScholarlyArticle",
    "name": "the_twelve_hash_bits_read_back_from_the_third_group",
    "description": "∀ b6 b7 : Nat, b6 < 256 → b7 < 256 → ((or8 (and8 b6 15) 128) * 256 + b7) / 4096 = 8 ∧ ((or8 (and8 b6 15) 128) * 256 + b7) % 4096 = b6 % 16 * 256 + b7",
    "identifier": "lean_address_the_twelve_hash_bits_read_back_from_the_third_group",
    "url": "https://ceccec.psg.bg/millennium-solutions/theorem/lean_address_the_twelve_hash_bits_read_back_from_the_third_group",
    "receipt": "221f974c-1535-8b78-9067-631b2ca17996",
