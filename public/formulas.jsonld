    "name": "both_parts_sum_to_zero",
    "description": "m9 ((R.filter (fun d => R.any (fun e => m9 (d * e) == 1))).foldl (· + ·) 0) == 0 ∧ m9 ((R.filter (fun d => ! R.any (fun e => m9 (d * e) == 1))).foldl (· + ·) 0) == 0",
    "identifier": "lean_z9plus_both_parts_sum_to_zero",
    "url": "https://ceccec.psg.bg/millennium-solutions/theorem/lean_z9plus_both_parts_sum_to_zero",
    "receipt": "b30de9fd-1e1a-83a8-87cf-eda56d9b0afd",
    "about": {
     "@type": "DefinedTerm",
     "name": "Z9Plus"
    },
    "wing": "the ring",
    "source": "z9plus.lean",
    "proof": "by exhaustion"
   }
