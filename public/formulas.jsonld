  {
   "@type": "ListItem",
   "position": 21,
   "item": {
    "@type": "ScholarlyArticle",
    "name": "stamping_twice_is_stamping_once",
    "description": "∀ b : Nat, b < 256 → or8 (and8 (or8 (and8 b 15) 128) 15) 128 = or8 (and8 b 15) 128 ∧ or8 (and8 (or8 (and8 b 63) 128) 63) 128 = or8 (and8 b 63) 128",
    "identifier": "lean_address_stamping_twice_is_stamping_once",
    "url": "https://ceccec.psg.bg/millennium-solutions/theorem/lean_address_stamping_twice_is_stamping_once",
