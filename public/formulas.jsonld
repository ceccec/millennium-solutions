   }
  },
  {
   "@type": "ListItem",
   "position": 23,
   "item": {
    "@type": "ScholarlyArticle",
    "name": "the_fourth_group_is_variant_two_over_fourteen_hash_bits",
    "description": "∀ b8 b9 : Nat, b8 < 256 → b9 < 256 → (or8 (and8 b8 63) 128) * 256 + b9 = 2 * 16384 + (b8 % 64 * 256 + b9) ∧ b8 % 64 * 256 + b9 < 16384",
    "identifier": "lean_address_the_fourth_group_is_variant_two_over_fourteen_hash_bits",
    "url": "https://ceccec.psg.bg/millennium-solutions/theorem/lean_address_the_fourth_group_is_variant_two_over_fourteen_hash_bits",
    "receipt": "087841c4-271d-88a9-bc1e-0f97cbea43a6",
