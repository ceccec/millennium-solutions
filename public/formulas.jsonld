  {
   "@type": "ListItem",
   "position": 22,
   "item": {
    "@type": "ScholarlyArticle",
    "name": "the_third_group_is_version_eight_over_twelve_hash_bits",
    "description": "∀ b6 b7 : Nat, b6 < 256 → b7 < 256 → (or8 (and8 b6 15) 128) * 256 + b7 = 8 * 4096 + (b6 % 16 * 256 + b7) ∧ b6 % 16 * 256 + b7 < 4096",
    "identifier": "lean_address_the_third_group_is_version_eight_over_twelve_hash_bits",
    "url": "https://ceccec.psg.bg/millennium-solutions/theorem/lean_address_the_third_group_is_version_eight_over_twelve_hash_bits",
    "receipt": "136a86a7-b50b-8cf4-b273-943a5144e674",
    "about": {
